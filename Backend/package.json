{
  "name": "tally-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express + PostgreSQL API for Tally. Also serves the Frontend/ pages.",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
